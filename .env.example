# Senha para entrar em /admin
ADMIN_PASSWORD=uma-senha-forte
# Segredo longo e aleatório para assinar a sessão (veja o README para gerar um)
ADMIN_SESSION_SECRET=um-segredo-longo-e-aleatorio
# Connection string do Neon (somente servidor, NUNCA com prefixo NEXT_PUBLIC_).
# Na Vercel, a integração Neon (aba Storage) cria esta variável sozinha.
# Em desenvolvimento, deixe sem: o site usa um banco local fora da pasta do projeto
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# (opcional) URL pública do site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# (opcional) WhatsApp da Maysa, só dígitos com DDI. Padrão: 5531992712047
NEXT_PUBLIC_WHATSAPP_NUMBER=5531992712047

# Aviso automático no WhatsApp da Maysa (CallMeBot). Ativação: a Maysa salva +34 644 91 07 79
# e manda "I allow callmebot to send me messages"; a resposta traz a APIKEY.
CALLMEBOT_APIKEY=
