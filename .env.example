# Senha para entrar em /admin
ADMIN_PASSWORD=uma-senha-forte
# Segredo longo e aleatório para assinar a sessão (ex.: openssl rand -hex 32)
ADMIN_SESSION_SECRET=um-segredo-longo-e-aleatorio
# Connection string do Neon (somente servidor, NUNCA com prefixo NEXT_PUBLIC_)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# URL pública do site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# (opcional) WhatsApp da Maysa, só dígitos com DDI. Padrão: 5531992712047
NEXT_PUBLIC_WHATSAPP_NUMBER=5531992712047
